@charset "utf-8";

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html, body { margin: 0px; height: 100%; background: rgb(0, 0, 0); overflow: hidden; touch-action: none; user-select: none; font-family: system-ui, -apple-system, Roboto, sans-serif; color: rgb(238, 238, 238); }

canvas#game { position: fixed; inset: 0px; width: 100%; height: 100%; image-rendering: crisp-edges; background: rgb(0, 0, 0); z-index: 0; }

#grain { position: fixed; inset: -40px; z-index: 2; pointer-events: none; opacity: 0.1; mix-blend-mode: overlay; animation: 0.45s steps(5) 0s infinite normal none running gr; }

@keyframes gr { 
  0% { transform: translate(0px, 0px); }
  20% { transform: translate(-14px, 9px); }
  40% { transform: translate(11px, -17px); }
  60% { transform: translate(-8px, -6px); }
  80% { transform: translate(16px, 12px); }
  100% { transform: translate(0px, 0px); }
}

#vig { position: fixed; inset: 0px; z-index: 3; pointer-events: none; background: radial-gradient(transparent 38%, rgba(0, 0, 0, 0.88) 100%); }

#red { position: fixed; inset: 0px; z-index: 3; pointer-events: none; opacity: 0; background: radial-gradient(transparent 28%, rgba(190, 0, 0, 0.75) 100%); }

#hud { position: fixed; inset: 0px; z-index: 5; pointer-events: none; }

#meter { position: absolute; left: max(14px,env(safe-area-inset-left)); top: max(10px,env(safe-area-inset-top)); }

#mrow { display: flex; align-items: center; gap: 3px; position: relative; }

#mic { font-size: 17px; margin-right: 4px; filter: drop-shadow(rgb(0, 0, 0) 0px 0px 4px); }

.seg { width: 30px; height: 12px; background: rgba(255, 255, 255, 0.14); border-radius: 2px; overflow: hidden; outline: rgba(0, 0, 0, 0.6) solid 1px; }

.seg i { display: block; height: 100%; width: 0px; background: var(--c); box-shadow: 0 0 10px var(--c); }

#mlab { font-size: 12px; margin-top: 4px; font-weight: 700; letter-spacing: 0.02em; text-shadow: rgb(0, 0, 0) 0px 1px 3px; }

#mhear { font-size: 11px; opacity: 0.8; text-shadow: rgb(0, 0, 0) 0px 1px 3px; }

#ping { position: absolute; left: 58px; top: 6px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--pc,#fff); opacity: 0; pointer-events: none; }

#ping.go { animation: 0.9s ease-out 0s 1 normal none running png; }

@keyframes png { 
  0% { opacity: 0.9; transform: translate(-50%, -50%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(14); }
}

#keys { position: absolute; right: max(70px,env(safe-area-inset-right)); top: max(10px,env(safe-area-inset-top)); font-size: 18px; text-shadow: rgb(0, 0, 0) 0px 1px 4px; background: rgba(0, 0, 0, 0.35); padding: 4px 10px; border-radius: 14px; }

#msg { position: absolute; left: 0px; right: 0px; top: 20%; text-align: center; font-size: 18px; text-shadow: rgb(0, 0, 0) 0px 2px 6px; opacity: 0; transition: opacity 0.4s; }

#title { position: fixed; left: 0px; right: 0px; top: 36%; z-index: 9; pointer-events: none; text-align: center; font-size: 26px; font-weight: 300; letter-spacing: 0.08em; opacity: 0; text-shadow: rgb(0, 0, 0) 0px 0px 18px; transition: opacity 1.2s; }

#touch { position: fixed; inset: 0px; z-index: 6; touch-action: none; }

#joy { position: fixed; z-index: 7; width: 128px; height: 128px; margin: -64px 0px 0px -64px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.28); background: rgba(255, 255, 255, 0.06); pointer-events: none; opacity: 0.45; left: 96px; top: calc(100% - 96px); }

#knob { position: absolute; left: 50%; top: 50%; width: 54px; height: 54px; margin: -27px 0px 0px -27px; border-radius: 50%; background: rgba(255, 255, 255, 0.35); border: 2px solid rgba(255, 255, 255, 0.6); }

.btn { position: fixed; z-index: 8; width: 56px; height: 56px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.35); background: rgba(0, 0, 0, 0.45); color: rgb(255, 255, 255); font-size: 24px; display: flex; align-items: center; justify-content: center; touch-action: manipulation; }

#bPause { right: max(12px,env(safe-area-inset-right)); top: max(8px,env(safe-area-inset-top)); width: 44px; height: 44px; font-size: 18px; }

#bFlash { right: max(22px,env(safe-area-inset-right)); bottom: max(26px,env(safe-area-inset-bottom)); }

#bFlash.on { background: rgba(255, 235, 150, 0.35); border-color: rgb(255, 227, 138); }

#bShout { right: max(22px,env(safe-area-inset-right)); bottom: calc(max(26px,env(safe-area-inset-bottom)) + 70px); display: none; }

#scare { position: fixed; inset: 0px; width: 100%; height: 100%; z-index: 10; display: none; background: rgb(0, 0, 0); image-rendering: auto; }

#fade { position: fixed; inset: 0px; background: rgb(0, 0, 0); z-index: 11; opacity: 1; pointer-events: none; transition: opacity 0.7s; }

.ov { position: fixed; inset: 0px; z-index: 20; display: none; align-items: center; justify-content: center; flex-direction: column; background: rgba(6, 5, 2, 0.9); text-align: center; padding: 16px; overflow: auto; }

.ov h1 { margin: 0px 0px 6px; font-size: 34px; font-weight: 300; letter-spacing: 0.1em; color: rgb(232, 211, 106); text-shadow: rgba(232, 211, 106, 0.4) 0px 0px 22px; }

.ov p { margin: 4px 0px; font-size: 14px; line-height: 1.45; max-width: 520px; opacity: 0.88; }

.leg { display: flex; gap: 14px; justify-content: center; margin: 8px 0px; font-size: 12px; flex-wrap: wrap; }

.leg b { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 5px; vertical-align: -1px; }

.sl { display: flex; align-items: center; gap: 10px; margin: 4px 0px; font-size: 13px; }

.sl input { width: 150px; }

.go-btn { margin-top: 12px; padding: 12px 34px; font-size: 18px; border-radius: 26px; border: 2px solid rgb(232, 211, 106); background: rgba(232, 211, 106, 0.12); color: rgb(243, 231, 160); touch-action: manipulation; }

#rot { position: fixed; inset: 0px; z-index: 30; background: rgb(0, 0, 0); display: none; align-items: center; justify-content: center; font-size: 20px; text-align: center; padding: 30px; }
